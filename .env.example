# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# On Vercel, add this in Project Settings -> Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_ACCESS_SECRET: Long, secure private passphrase to lock the entire app on Vercel / server.
# Recommended length: 16 to 64+ random characters. Leave blank only if using local-device vault setup.
APP_ACCESS_SECRET=""

# SESSION_SIGNING_SECRET: Optional separate random secret used to sign HttpOnly session cookies.
SESSION_SIGNING_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
